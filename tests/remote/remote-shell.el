; M-x shell and M-x term in a remote buffer run on its machine, in its
; directory there, on a remote pseudo-terminal, with the remote user's
; $SHELL. Remote shells have buffers of their own, apart from local
; ones, also with C-u and C-u N. Typed C-c, C-c C-c in line mode,
; resizing and C-d reach the remote program.
(shell-command "rm -rf $XZ_REMOTE_HOME/t $XZ_REMOTE_HOME/out && mkdir -p $XZ_REMOTE_HOME/t/sub && echo text > $XZ_REMOTE_HOME/t/f.txt")
(execute-kbd-macro "\C-x\C-f\M-lxztest\rt/f.txt\r")
(execute-kbd-macro "\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "echo 1:$XZ_REMOTE_SHELL:$(pwd | sed s,^$HOME,~,):${SSH_CONNECTION:+ssh}:$INSIDE_XZILE >> ~/out; tty | sed 's,[0-9]*$,N,' >> ~/out\r")
(sit-for 1)
; C-c interrupts the remote sleep, not ssh: the shell goes on.
(execute-kbd-macro "sleep 30; echo not interrupted >> ~/out\r")
(sit-for 1)
(execute-kbd-macro "\C-c")
(sit-for 1)
(execute-kbd-macro "echo after C-c >> ~/out\r")
(sit-for 1)
(execute-kbd-macro "sleep 30; echo not interrupted >> ~/out\r")
(sit-for 1)
(execute-kbd-macro "\C-x\C-j\C-c\C-cq")
(sit-for 1)
(execute-kbd-macro "echo after C-c C-c >> ~/out\r")
(sit-for 1)
; A smaller window gives the remote terminal fewer rows.
(execute-kbd-macro "stty size > ~/size1\r")
(sit-for 1)
(split-window)
(sit-for 1)
(execute-kbd-macro "stty size > ~/size2; test $(cut -d' ' -f1 ~/size2) -lt $(cut -d' ' -f1 ~/size1) && echo fewer rows >> ~/out\r")
(sit-for 1)
(delete-other-windows)
; The directory follows OSC 7 from the remote machine, and only from it.
(execute-kbd-macro "cd sub; printf '\\033]7;file://%s%s\\007' $(uname -n) $PWD; printf '\\033]7;file://elsewhere.invalid/tmp\\007'\r")
(sit-for 1)
; In the remote shell's buffer, shell-command runs there too.
(execute-kbd-macro "\M-xshell-command\recho 2:$(pwd | sed s,^$HOME,~,) >> ~/out\r")
; Compilation and Magit are still refused there; dired-jump lists the
; remote directory.
(execute-kbd-macro "\M-xcompile\r\M-xmagit-status\r\M-xdired-jump\r")
(switch-to-buffer "*shell ssh:xztest*")
; C-d: end of input, so the shell exits; M-x shell starts another in
; the same buffer and directory.
(execute-kbd-macro "\C-d")
(sit-for 2)
(execute-kbd-macro "\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "echo 3:$(pwd | sed s,^$HOME,~,) >> ~/out\r")
(sit-for 1)
; A local shell, and local and remote shells numbered 2.
(switch-to-buffer "remote-shell.input")
(execute-kbd-macro "\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "echo local:${SSH_CONNECTION:-no ssh}:${XZ_REMOTE_SHELL:-local shell} >> $XZ_REMOTE_HOME/out\r")
(sit-for 1)
(switch-to-buffer "remote-shell.input")
(execute-kbd-macro "\C-u2\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "echo local 2:${SSH_CONNECTION:-no ssh} >> $XZ_REMOTE_HOME/out\r")
(sit-for 1)
(switch-to-buffer "f.txt")
(execute-kbd-macro "\C-u2\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "echo remote 2:${SSH_CONNECTION:+ssh} >> ~/out\r")
(sit-for 1)
; Reused: *shell* here, *shell ssh:xztest* there; C-u: a new one there.
(switch-to-buffer "remote-shell.input")
(execute-kbd-macro "\M-xshell\recho local again >> $XZ_REMOTE_HOME/out\r")
(sit-for 1)
(switch-to-buffer "f.txt")
(execute-kbd-macro "\M-xshell\recho 4:$(pwd | sed s,^$HOME,~,) >> ~/out\r")
(sit-for 1)
(switch-to-buffer "f.txt")
(execute-kbd-macro "\C-u\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "echo new:$(pwd | sed s,^$HOME,~,) >> ~/out\r")
(sit-for 1)
; M-x term offers the remote $SHELL.
(switch-to-buffer "f.txt")
(execute-kbd-macro "\M-xterm\r\r")
(sit-for 1)
(execute-kbd-macro "echo term:$XZ_REMOTE_SHELL:$(pwd | sed s,^$HOME,~,) >> ~/out; exit\r")
(sit-for 2)
(switch-to-buffer "*terminal ssh:xztest*")
(mark-whole-buffer)
(copy-region-as-kill (point) (mark))
(switch-to-buffer "remote-shell.input")
(yank)
(list-buffers)
(other-window 1)
(mark-whole-buffer)
(copy-region-as-kill (point) (mark))
(other-window -1)
(yank)
(set-mark (point))
(goto-char 1)
; Each buffer's name, mode and location, without its flags or size.
(shell-command-on-region (mark) (point) "grep -e '[*]shell' -e '[*]terminal' -e Dired -e ^Process | sed -e 's/^ [^ ]*  *//' -e 's/  *[0-9][0-9]*  */ | /' -e 's/ *$//' -e 's/   */ | /g' | LC_ALL=C sort" t t)
(shell-command "cat $XZ_REMOTE_HOME/out" t)
(save-buffer)
(execute-kbd-macro "\C-x\C-cyes\r")
