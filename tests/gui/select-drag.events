# A drag in a terminal in char mode selects the text on the screen
# from the cell pressed to the one released, both included, shows it
# in the region face, and copies it on release; a yank in the file
# then inserts it.
down x alt
text x
up x alt
sleep 200
text term
down Return
sleep 300
down a ctrl
up a ctrl
down k ctrl
up k ctrl
text sh -c "printf 'hello world
text \nsecond line\n'; read x"
down Return
sleep 1000
sample plain 0 7
press 0 6
sleep 100
drag 1 3
sleep 100
drag 1 5
sleep 300
sample selected 0 7
differ plain selected
release 1 5
sleep 300
# End the program, so that quitting asks nothing.
down Return
sleep 500
down x ctrl
up x ctrl
down b
text b
sleep 200
down Return
sleep 300
down y ctrl
up y ctrl
