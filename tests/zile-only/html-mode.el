; html-mode edits HTML as text, and binds the preview commands.
(html-mode)
(describe-key "\C-c\C-v")
(other-window 1)
(set-mark (point))
(forward-line)
(copy-region-as-kill (mark) (point))
(other-window -1)
(goto-char (point-min))
(yank)
(insert "<p>")
(end-of-line)
(insert "</p>")
(save-buffer)
(save-buffers-kill-emacs)
