; markdown-mode binds its commands under C-c.
(markdown-mode)
(describe-key "\C-c\C-a")
(other-window 1)
(set-mark (point))
(forward-line)
(copy-region-as-kill (mark) (point))
(other-window -1)
(goto-char (point-min))
(yank)
(describe-key "\C-c\C-v")
(other-window 1)
(set-mark (point))
(forward-line)
(copy-region-as-kill (mark) (point))
(other-window -1)
(yank)
(save-buffer)
(save-buffers-kill-emacs)
