; M-x shell names its buffers *shell*, *shell*<2>, ...: C-u N M-x shell
; switches to *shell*<N>, starting it if needed, and C-u M-x shell starts
; another shell. Each shell sets A, so echo shows which one runs it.
(execute-kbd-macro "\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "A=one\r")
(switch-to-buffer "shell-prefix.input")
(execute-kbd-macro "\C-u2\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "A=two\r")
; Reuse the running shells.
(switch-to-buffer "shell-prefix.input")
(execute-kbd-macro "\M-2\M-xshell\recho 2:$A >>shell-prefix.tmp\r")
(switch-to-buffer "shell-prefix.input")
(execute-kbd-macro "\M-xshell\recho 1:$A >>shell-prefix.tmp\r")
(switch-to-buffer "shell-prefix.input")
(execute-kbd-macro "\C-u1\M-xshell\recho 1:$A >>shell-prefix.tmp\r")
(sit-for 1)
; A fresh shell, in *shell*<3>.
(switch-to-buffer "shell-prefix.input")
(execute-kbd-macro "\C-u\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "echo new:${A-unset} >>shell-prefix.tmp; A=three; exit\r")
(sit-for 2)
; Its shell has exited: start another in the same buffer.
(switch-to-buffer "shell-prefix.input")
(execute-kbd-macro "\C-u3\M-xshell\r")
(sit-for 1)
(execute-kbd-macro "echo 3:${A-restarted} >>shell-prefix.tmp\r")
(sit-for 1)
; No shell for 0, a negative number, or a buffer that is not a terminal.
(switch-to-buffer "shell-prefix.input")
(execute-kbd-macro "\C-u0\M-xshell\r\C-u-\M-xshell\r")
(switch-to-buffer "*shell*<5>")
(switch-to-buffer "shell-prefix.input")
(execute-kbd-macro "\C-u5\M-xshell\r")
(list-buffers)
(other-window 1)
(mark-whole-buffer)
(copy-region-as-kill (point) (mark))
(other-window -1)
(yank)
(set-mark (point))
(goto-char 1)
(shell-command-on-region (mark) (point) "grep -F '*shell*' | sed 's/ *$//'" t t)
(shell-command "cat shell-prefix.tmp; rm -f shell-prefix.tmp" t)
(save-buffer)
(execute-kbd-macro "\C-x\C-cyes\r")
